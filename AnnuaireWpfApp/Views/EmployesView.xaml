<UserControl x:Class="AnnuaireWpfApp.Views.EmployesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- Liste des employés -->
        <Grid Grid.Column="0" Margin="0,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Recherche -->
            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                <TextBox x:Name="txtRecherche" 
                        Padding="8"
                        FontSize="14"
                        TextChanged="TxtRecherche_TextChanged"/>
                <TextBlock Text="Rechercher par nom ou prénom" 
                          FontSize="11" 
                          Opacity="0.6"
                          Margin="5,3,0,0"/>
            </StackPanel>

            <!-- Liste -->
            <ListBox x:Name="lstEmployes" 
                    Grid.Row="1"
                    SelectionChanged="LstEmployes_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="5">
                            <TextBlock Text="{Binding Nom}" 
                                      FontWeight="Bold" 
                                      FontSize="14"/>
                            <TextBlock Text="{Binding Prenom}" 
                                      FontSize="12" 
                                      Opacity="0.7"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- Détails de l'employé -->
        <Border Grid.Column="1" 
               BorderBrush="#E0E0E0" 
               BorderThickness="1" 
               Padding="20"
               Background="White">
            <StackPanel x:Name="pnlDetails" Visibility="Collapsed">
                <TextBlock Text="Fiche employé" 
                          FontSize="20" 
                          FontWeight="Bold"
                          Margin="0,0,0,20"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" 
                              Text="Nom :" 
                              FontWeight="Bold" 
                              Margin="0,10"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" 
                              x:Name="txtNom" 
                              Margin="0,10"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" 
                              Text="Prénom :" 
                              FontWeight="Bold" 
                              Margin="0,10"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" 
                              x:Name="txtPrenom" 
                              Margin="0,10"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" 
                              Text="Tél. fixe :" 
                              FontWeight="Bold" 
                              Margin="0,10"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" 
                              x:Name="txtTelFixe" 
                              Margin="0,10"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" 
                              Text="Tél. portable :" 
                              FontWeight="Bold" 
                              Margin="0,10"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" 
                              x:Name="txtTelPortable" 
                              Margin="0,10"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" 
                              Text="Email :" 
                              FontWeight="Bold" 
                              Margin="0,10"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" 
                              x:Name="txtEmail" 
                              Margin="0,10"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" 
                              Text="Service :" 
                              FontWeight="Bold" 
                              Margin="0,10"/>
                    <TextBlock Grid.Row="5" Grid.Column="1" 
                              x:Name="txtService" 
                              Margin="0,10"/>

                    <TextBlock Grid.Row="6" Grid.Column="0" 
                              Text="Site :" 
                              FontWeight="Bold" 
                              Margin="0,10"/>
                    <TextBlock Grid.Row="6" Grid.Column="1" 
                              x:Name="txtSite" 
                              Margin="0,10"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
