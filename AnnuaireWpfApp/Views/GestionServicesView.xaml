<UserControl x:Class="AnnuaireWpfApp.Views.GestionServicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- Liste des services -->
        <Border Grid.Column="0" 
                BorderBrush="#E0E0E0" 
                BorderThickness="0,0,1,0"
                Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" 
                          Text="Liste des services" 
                          FontSize="16" 
                          FontWeight="Bold"
                          Margin="0,0,0,15"/>

                <DataGrid x:Name="dgServices" 
                         Grid.Row="1"
                         AutoGenerateColumns="False"
                         IsReadOnly="True"
                         SelectionMode="Single"
                         CanUserAddRows="False"
                         SelectionChanged="DgServices_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                        <DataGridTextColumn Header="Nom du service" Binding="{Binding Nom}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Button x:Name="btnNouveauService" 
                       Grid.Row="2"
                       Content="Nouveau service" 
                       Padding="15,8"
                       Margin="0,10,0,0"
                       Background="#2196F3"
                       Foreground="White"
                       FontWeight="Bold"
                       Click="BtnNouveauService_Click"/>
            </Grid>
        </Border>

        <!-- Formulaire d'édition -->
        <Border Grid.Column="1" Padding="20">
            <StackPanel x:Name="pnlFormulaire" Visibility="Collapsed">
                <TextBlock x:Name="txtTitreForm" 
                          Text="Nouveau service" 
                          FontSize="20" 
                          FontWeight="Bold"
                          Margin="0,0,0,25"/>

                <TextBlock Text="Nom du service" 
                          FontWeight="Bold" 
                          Margin="0,0,0,5"/>
                <TextBox x:Name="txtNom" 
                        Padding="8"
                        FontSize="14"
                        Margin="0,0,0,20"/>

                <StackPanel Orientation="Horizontal" 
                           HorizontalAlignment="Right"
                           Margin="0,20,0,0">
                    <Button x:Name="btnEnregistrer" 
                           Content="Enregistrer" 
                           Padding="20,8"
                           Margin="0,0,10,0"
                           Background="#4CAF50"
                           Foreground="White"
                           FontWeight="Bold"
                           Click="BtnEnregistrer_Click"/>

                    <Button x:Name="btnAnnuler" 
                           Content="Annuler" 
                           Padding="20,8"
                           Background="#757575"
                           Foreground="White"
                           Click="BtnAnnuler_Click"/>
                </StackPanel>

                <Border BorderBrush="#E0E0E0" 
                       BorderThickness="0,1,0,0" 
                       Margin="0,30,0,20"
                       Padding="0,20,0,0">
                    <Button x:Name="btnSupprimer" 
                           Content="Supprimer ce service" 
                           Padding="15,8"
                           Background="#F44336"
                           Foreground="White"
                           FontWeight="Bold"
                           Visibility="Collapsed"
                           Click="BtnSupprimer_Click"/>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
