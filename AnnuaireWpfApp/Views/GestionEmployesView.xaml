<UserControl x:Class="AnnuaireWpfApp.Views.GestionEmployesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.5*"/>
            <ColumnDefinition Width="2.5*"/>
        </Grid.ColumnDefinitions>

        <!-- Liste des employés -->
        <Border Grid.Column="0" 
                BorderBrush="#E0E0E0" 
                BorderThickness="0,0,1,0"
                Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" 
                          Text="Liste des employés" 
                          FontSize="16" 
                          FontWeight="Bold"
                          Margin="0,0,0,15"/>

                <DataGrid x:Name="dgEmployes" 
                         Grid.Row="1"
                         AutoGenerateColumns="False"
                         IsReadOnly="True"
                         SelectionMode="Single"
                         CanUserAddRows="False"
                         SelectionChanged="DgEmployes_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nom" Binding="{Binding Nom}" Width="*"/>
                        <DataGridTextColumn Header="Prénom" Binding="{Binding Prenom}" Width="*"/>
                        <DataGridTextColumn Header="Site" Binding="{Binding Site.Ville}" Width="80"/>
                        <DataGridTextColumn Header="Service" Binding="{Binding Service.Nom}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Button x:Name="btnNouvelEmploye" 
                       Grid.Row="2"
                       Content="Nouvel employé" 
                       Padding="15,8"
                       Margin="0,10,0,0"
                       Background="#2196F3"
                       Foreground="White"
                       FontWeight="Bold"
                       Click="BtnNouvelEmploye_Click"/>
            </Grid>
        </Border>

        <!-- Formulaire d'édition -->
        <Border Grid.Column="1" Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="pnlFormulaire" Visibility="Collapsed">
                    <TextBlock x:Name="txtTitreForm" 
                              Text="Nouvel employé" 
                              FontSize="20" 
                              FontWeight="Bold"
                              Margin="0,0,0,20"/>

                    <TextBlock Text="Nom" 
                              FontWeight="Bold" 
                              Margin="0,0,0,5"/>
                    <TextBox x:Name="txtNom" 
                            Padding="8"
                            FontSize="14"
                            Margin="0,0,0,15"/>

                    <TextBlock Text="Prénom" 
                              FontWeight="Bold" 
                              Margin="0,0,0,5"/>
                    <TextBox x:Name="txtPrenom" 
                            Padding="8"
                            FontSize="14"
                            Margin="0,0,0,15"/>

                    <TextBlock Text="Téléphone fixe" 
                              FontWeight="Bold" 
                              Margin="0,0,0,5"/>
                    <TextBox x:Name="txtTelFixe" 
                            Padding="8"
                            FontSize="14"
                            Margin="0,0,0,15"/>

                    <TextBlock Text="Téléphone portable" 
                              FontWeight="Bold" 
                              Margin="0,0,0,5"/>
                    <TextBox x:Name="txtTelPortable" 
                            Padding="8"
                            FontSize="14"
                            Margin="0,0,0,15"/>

                    <TextBlock Text="Email" 
                              FontWeight="Bold" 
                              Margin="0,0,0,5"/>
                    <TextBox x:Name="txtEmail" 
                            Padding="8"
                            FontSize="14"
                            Margin="0,0,0,15"/>

                    <TextBlock Text="Site" 
                              FontWeight="Bold" 
                              Margin="0,0,0,5"/>
                    <ComboBox x:Name="cboSite" 
                             Padding="8"
                             FontSize="14"
                             DisplayMemberPath="Ville"
                             SelectedValuePath="Id"
                             Margin="0,0,0,15"/>

                    <TextBlock Text="Service" 
                              FontWeight="Bold" 
                              Margin="0,0,0,5"/>
                    <ComboBox x:Name="cboService" 
                             Padding="8"
                             FontSize="14"
                             DisplayMemberPath="Nom"
                             SelectedValuePath="Id"
                             Margin="0,0,0,15"/>

                    <StackPanel Orientation="Horizontal" 
                               HorizontalAlignment="Right"
                               Margin="0,15,0,0">
                        <Button x:Name="btnEnregistrer" 
                               Content="Enregistrer" 
                               Padding="20,8"
                               Margin="0,0,10,0"
                               Background="#4CAF50"
                               Foreground="White"
                               FontWeight="Bold"
                               Click="BtnEnregistrer_Click"/>

                        <Button x:Name="btnAnnuler" 
                               Content="Annuler" 
                               Padding="20,8"
                               Background="#757575"
                               Foreground="White"
                               Click="BtnAnnuler_Click"/>
                    </StackPanel>

                    <Border BorderBrush="#E0E0E0" 
                           BorderThickness="0,1,0,0" 
                           Margin="0,25,0,15"
                           Padding="0,20,0,0">
                        <Button x:Name="btnSupprimer" 
                               Content="Supprimer cet employé" 
                               Padding="15,8"
                               Background="#F44336"
                               Foreground="White"
                               FontWeight="Bold"
                               Visibility="Collapsed"
                               Click="BtnSupprimer_Click"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
