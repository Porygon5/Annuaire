<UserControl x:Class="AnnuaireWpfApp.Views.ServicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- Liste des services -->
        <Grid Grid.Column="0" Margin="0,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" 
                      Text="Sélectionnez un service" 
                      FontSize="16" 
                      FontWeight="Bold"
                      Margin="0,0,0,15"/>

            <ListBox x:Name="lstServices" 
                    Grid.Row="1"
                    SelectionChanged="LstServices_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="5">
                            <TextBlock Text="{Binding Nom}" 
                                      FontWeight="Bold" 
                                      FontSize="16"/>
                            <TextBlock FontSize="12" 
                                      Opacity="0.7">
                                <Run Text="{Binding Employes.Count, Mode=OneWay}"/>
                                <Run Text="employé(s)"/>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- Liste des employés du service -->
        <Border Grid.Column="1" 
               BorderBrush="#E0E0E0" 
               BorderThickness="1" 
               Padding="20"
               Background="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="txtTitreService" 
                          Grid.Row="0"
                          Text="Employés du service" 
                          FontSize="18" 
                          FontWeight="Bold"
                          Margin="0,0,0,15"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="lstEmployesService">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#E0E0E0" 
                                       BorderThickness="0,0,0,1" 
                                       Padding="10"
                                       Margin="0,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0"
                                                  FontWeight="Bold" 
                                                  FontSize="15">
                                            <Run Text="{Binding Nom}"/>
                                            <Run Text="{Binding Prenom}"/>
                                        </TextBlock>

                                        <TextBlock Grid.Row="1" Grid.Column="0"
                                                  Text="{Binding Site.Ville}"
                                                  FontSize="13"
                                                  Opacity="0.7"
                                                  Margin="0,3,0,0"/>

                                        <StackPanel Grid.Row="2" Grid.Column="0" 
                                                   Orientation="Horizontal"
                                                   Margin="0,5,0,0">
                                            <TextBlock Text="Tel. fixe: " FontSize="12" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding TelephoneFixe}" 
                                                      FontSize="12"
                                                      Margin="0,0,15,0"/>
                                            <TextBlock Text="Portable: " FontSize="12" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding TelephonePortable}" 
                                                      FontSize="12"/>
                                        </StackPanel>

                                        <TextBlock Grid.Row="0" Grid.Column="1" 
                                                  Grid.RowSpan="2"
                                                  Text="{Binding Email}"
                                                  FontSize="12"
                                                  Opacity="0.6"
                                                  VerticalAlignment="Center"
                                                  Margin="10,0,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
